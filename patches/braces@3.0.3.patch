diff --git a/lib/depth-guard.js b/lib/depth-guard.js
new file mode 100644
index 0000000000000000000000000000000000000000..36e944c714ed3dbe710118b9b1c8d23cff1ee63f
--- /dev/null
+++ b/lib/depth-guard.js
@@ -0,0 +1,20 @@
+'use strict';
+
+// AST walkers are recursive. Validate iteratively before entering them so
+// attacker-controlled nesting or cyclic ASTs cannot exhaust the call stack.
+module.exports = ast => {
+  const stack = [[ast, 0]];
+  const seen = new WeakSet();
+  let count = 0;
+  while (stack.length) {
+    const [node, depth] = stack.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 128 || seen.has(node) || ++count > 100000) {
+      throw new RangeError('Brace pattern exceeds safe AST limits');
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) stack.push([child, depth + 1]);
+    }
+  }
+};
